{
  "name": "@local/dsh-skill-evolution-backtest",
  "version": "1.8.0",
  "icon": "./icon.svg",
  "private": true,
  "type": "module",
  "description": "Packages the deterministic half of the Mnemon skill-evolution pipeline as agent tools: scan pending suggestions, per-check partial-score backtest of a candidate draft vs the current SKILL.md, atomic ledger write with backup + concurrency guard, and independent re-read verification. The creative half (writing the improved SKILL.md) stays with the agent.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mnemon",
    "skill-evolution",
    "backtest",
    "partial-score",
    "atomic-write"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": "./index.js",
    "./icon": "./icon.svg",
    "./client": "./lib/client/index.js"
  },
  "files": [
    "index.js",
    "lib/paths.mjs",
    "lib/hash.mjs",
    "lib/grade.mjs",
    "lib/ledger.mjs",
    "lib/vendor/yaml",
    "lib/client/index.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "selftest.mjs"
  ],
  "scripts": {
    "test": "node selftest.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  }
}